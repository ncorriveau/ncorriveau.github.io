source "https://rubygems.org"

# Matches the exact gem versions GitHub Pages builds with, so local preview
# reflects production. Only needed for `bundle exec jekyll serve` — GitHub
# builds the site server-side and ignores this file.
gem "github-pages", group: :jekyll_plugins

gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end
